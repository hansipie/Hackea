# OpenAI key, for development only. The site never spends a key of its own:
# visitors paste theirs into the app, and every AI feature runs on it. Locally,
# pasting hackea-dev-mock-key-000000 into the app uses this key instead (never in
# production). The recording scripts use it too: re-record the voice clips with
# `npm run voice`. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: the GitHub repo shown (with its star count) in the nav.
# NEXT_PUBLIC_GITHUB_REPO=owner/hackea   (shows the star button and issue links once set)

# Optional: comma separated model lists, tried in order.
# OPENAI_TEXT_MODEL=gpt-6-luna,gpt-4.1-mini
# OPENAI_VISION_MODEL=gpt-6.1-terra,gpt-4.1-mini
# OPENAI_READ_MODEL=gpt-6.1-terra,gpt-4.1-mini
# OPENAI_PLAN_MODEL=gpt-6.1-sol,gpt-4.1

# Optional: the public URL, used for share cards, the sitemap and canonical links.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: bring back the manual scanner at /scan (parked for v2).
# NEXT_PUBLIC_SCAN=1
